{
  "name": "kestrel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.11 <27"
  },
  "scripts": {
    "check": "biome ci . && tsc --noEmit && tsc -p web --noEmit && node --test && node scripts/boundaries.ts && node scripts/check-design.ts && node evals/run.ts --stand-in && node evals/learn/run.ts && node evals/searches/run.ts && node evals/blocks/run.ts && node evals/news/run.ts",
    "prepare": "git config core.hooksPath .githooks",
    "dev": "PORT=8791 node --watch src/server/main.ts",
    "build": "vite build",
    "web": "vite",
    "deploy": "node scripts/deploy.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@hono/zod-validator": "0.9.1",
    "@tanstack/react-query": "5.107.1",
    "hono": "4.13.17",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
